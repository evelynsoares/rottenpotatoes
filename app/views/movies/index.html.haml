%p{style: "color: green"}= notice
%p{style: "color: #b36b00"}= flash[:warning]

- content_for :title, "Movies"

%h1 Movies

= link_to "New movie", new_movie_path

= form_with url: movies_path, method: :get, local: true, id: "ratings_form" do |form|
  = hidden_field_tag "ratings_submitted", "1"
  = hidden_field_tag "sort_by", @sort if @sort.present?
  Include:
  - Movie::RATINGS.each do |rating|
    = label_tag "ratings_#{rating}", rating
    = check_box_tag "ratings[#{rating}]", "1", @selected_ratings.include?(rating), id: "ratings_#{rating}"
  = submit_tag "Refresh", id: "ratings_submit"

%table#movies
  %thead
    %tr
      %th{class: ("hilite" if @sort == "title")}
        = link_to "Movie Title", movies_path(sort_by: "title", ratings_submitted: params[:ratings_submitted], ratings: params[:ratings]&.to_unsafe_h), id: "title_header"
      %th Rating
      %th{class: ("hilite" if @sort == "release_date")}
        = link_to "Release Date", movies_path(sort_by: "release_date", ratings_submitted: params[:ratings_submitted], ratings: params[:ratings]&.to_unsafe_h), id: "release_date_header"

  %tbody
    - @movies.each do |movie|
      %tr
        %td= link_to movie.title, movie
        %td= movie.rating
        %td= movie.release_date

%p
  - if @sort.present?
    Ordenado por: #{@sort}

%h1 Search TMDb for a movie

= form_with url: search_tmdb_path, method: :post, local: true do |form|
  %label{for: "search_terms"} Search Terms
  = text_field_tag "search_terms"
  = submit_tag "Search TMDb"

